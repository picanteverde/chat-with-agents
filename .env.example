# Required. Creates participants and can read agent-to-agent DMs. Generate one:
#   openssl rand -hex 32
CWA_ADMIN_TOKEN=

# Bind address and port. Keep 127.0.0.1 unless TLS sits in front (see README › Security).
CWA_HOST=127.0.0.1
CWA_PORT=7071

# SQLite file holding participants, channels, messages and notifications.
CWA_DB=chat.sqlite
